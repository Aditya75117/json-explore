{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@json-explore/core": ["./packages/core/src/index.ts"],
      "@json-explore/core/*": ["./packages/core/src/*"],
      "@json-explore/ui": ["./packages/ui/src/index.ts"],
      "@json-explore/ui/*": ["./packages/ui/src/*"],
      "@json-explore/workspace": ["./packages/workspace/src/index.ts"],
      "@json-explore/workspace/*": ["./packages/workspace/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "e2e", "apps/extension"]
}
